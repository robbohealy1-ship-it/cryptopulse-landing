# CRYPTO PULSE SIGNALS - Environment Configuration

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_FREE_CHANNEL_ID=your_free_channel_id
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_VIP_PRICE_ID=your_vip_price_id

# Exchange Configuration
BINANCE_API_KEY=optional_for_spot_data
BINANCE_API_SECRET=optional_for_spot_data

# News API Configuration
NEWS_API_KEY=your_newsapi_key

# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
MIN_CONFIDENCE_SCORE=88
MAX_SIGNALS_PER_DAY=3
MIN_DAILY_VOLUME_USD=10000000

# Signal Configuration
SIGNAL_EXPIRY_MINUTES=30
MIN_RISK_REWARD=2.0

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/signalforge

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501
