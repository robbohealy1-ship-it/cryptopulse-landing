# CRYPTO PULSE SIGNALS - Environment Configuration
# Copy this content to your .env file and fill in your actual values

# ==================== TELEGRAM ====================
# Get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Admin bot username (for signal approvals - private)
TELEGRAM_BOT_USERNAME=cryptopulse_admin_bot

# VIP bot (separate public bot for signup/payments)
# Create at @BotFather, use this username for VIP signup links
TELEGRAM_VIP_BOT_TOKEN=your_vip_bot_token_here
TELEGRAM_VIP_BOT_USERNAME=CryptoPulseVIPBot

# Your Telegram user ID (number only, no @ or -)
TELEGRAM_ADMIN_CHAT_ID=7726574032

# Your free channel ID (starts with @ or -100)
TELEGRAM_FREE_CHANNEL_ID=-1003965675544

# Your VIP channel ID (starts with -100)
TELEGRAM_VIP_CHANNEL_ID=-1003771790853

# ==================== VIP PRICING ====================
# Adjust these to change what users pay (USD)
VIP_MONTHLY_PRICE=49
VIP_QUARTERLY_PRICE=129
VIP_LIFETIME_PRICE=299

# Affiliate Exchange Settings
# Every signal ticker will link to this exchange with your ref code
# UK users: Binance & Bybit referrals are BLOCKED. OKX/Bitget/MEXC may also block.
# 
# SOLUTION for UK: Use 'custom' mode and paste ANY URL you want.
# Examples:
#   - Your own website
#   - A referral link that works for you
#   - A tracking link (bit.ly, etc.)
#   - Coinbase/Kraken/Luno link
#
# Exchange options: binance, bybit, okx, bitget, mexc, kucoin, custom
# Recommended for UK: custom (paste your own URL below)
AFFILIATE_EXCHANGE=custom
AFFILIATE_EXCHANGE_REF=

# CUSTOM URL: Paste ANY link here. Every signal ticker will link to this URL.
# Leave empty to just link to Google search for the coin.
# Example: AFFILIATE_CUSTOM_URL=https://www.kraken.com/?ref=YOURCODE
AFFILIATE_CUSTOM_URL=

# TRUST WALLET: Your wallet address for portfolio tracking (shown in alpha plays)
# DeBank profile link will be auto-generated. Optional.
# Example: TRUST_WALLET_ADDRESS=0x1234...
TRUST_WALLET_ADDRESS=

# ==================== SUPABASE ====================
# Get from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_anon_public_key_here
SUPABASE_SERVICE_KEY=your_service_role_secret_key_here

# ==================== CRYPTO WALLETS ====================
# Your cryptocurrency wallet addresses for receiving VIP payments
# IMPORTANT: Use addresses you control and can verify payments on

# Bitcoin address (starts with 1, 3, or bc1)
CRYPTO_WALLET_BTC=your_bitcoin_address_here

# Ethereum address (starts with 0x) - also used for LINK and HYPE tokens
CRYPTO_WALLET_ETH=your_ethereum_address_here

# Solana address (base58 encoded)
CRYPTO_WALLET_SOL=your_solana_address_here

# Litecoin address (starts with L or M)
CRYPTO_WALLET_LTC=your_litecoin_address_here

# Zcash address (starts with t or z)
CRYPTO_WALLET_ZEC=your_zcash_address_here

# Monero address (starts with 4)
CRYPTO_WALLET_XMR=your_monero_address_here

# ==================== FUNDAMENTAL DATA SOURCES ====================
# These enhance signal quality with real-time market intelligence

# News API - General crypto news (100 requests/day free)
# Get from: https://newsapi.org
NEWS_API_KEY=optional_get_from_newsapi_org

# CryptoPanic API - Crypto-specific news aggregator (free tier available)
# Get from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=optional_get_from_cryptopanic

# Glassnode API - On-chain metrics (free tier: 10 requests/day)
# Get from: https://studio.glassnode.com/settings/api
# Provides: whale movements, exchange flows, MVRV ratio, etc.
GLASSNODE_API_KEY=optional_get_from_glassnode

# Santiment API - Social sentiment & on-chain data (free tier available)
# Get from: https://app.santiment.net/account#api-keys
# Provides: social volume, dev activity, whale transactions
SANTIMENT_API_KEY=optional_get_from_santiment

# LunarCrush API - Social media analytics (free tier: 100 requests/day)
# Get from: https://lunarcrush.com/developers/api
# Provides: Twitter/social sentiment, influencer activity
LUNARCRUSH_API_KEY=optional_get_from_lunarcrush

# Messari API - Professional crypto data (free tier available)
# Get from: https://messari.io/api/docs
# Provides: metrics, news, research reports
MESSARI_API_KEY=optional_get_from_messari

# CoinMarketCap API - Market data & rankings (free tier: 333 requests/day)
# Get from: https://coinmarketcap.com/api/
# Provides: market cap, volume, trending coins
COINMARKETCAP_API_KEY=optional_get_from_coinmarketcap

# Etherscan API V2 - Covers ETH, Base, Arbitrum, and 50+ EVM chains with ONE key
# Get from: https://etherscan.io/apis → Register → API Keys
# Required for: real holder counts & top-10 concentration on ETH and Base tokens
# NOTE: Basescan merged into Etherscan V2. One key covers everything.
ETHERSCAN_API_KEY=optional_get_from_etherscan_io

# Legacy Basescan key (optional, only if you have an old key)
# New users: just set ETHERSCAN_API_KEY above, leave this blank
BASESCAN_API_KEY=

# The Graph API - Blockchain indexing (free)
# Get from: https://thegraph.com/studio/apikeys/
# Provides: DeFi protocol data, DEX volumes
THEGRAPH_API_KEY=optional_get_from_thegraph

# Dune Analytics API - Custom blockchain queries (free tier available)
# Get from: https://dune.com/settings/api
# Provides: custom on-chain analytics
DUNE_API_KEY=optional_get_from_dune

# TradingView Webhook - For custom alerts (optional)
# Set up webhooks in TradingView alerts
TRADINGVIEW_WEBHOOK_SECRET=optional_custom_secret_for_tradingview

# ==================== OPTIONAL - STRIPE ====================
# Only needed if you want to accept credit card payments
# Can skip entirely if using crypto payments only
STRIPE_SECRET_KEY=optional_skip_for_now
STRIPE_PUBLISHABLE_KEY=optional_skip_for_now
STRIPE_WEBHOOK_SECRET=optional_skip_for_now
STRIPE_VIP_PRICE_ID=optional_skip_for_now

# ==================== OPTIONAL - BINANCE API ====================
# Not required - public data is used by default
# Only add if you want authenticated API access
BINANCE_API_KEY=optional_not_needed
BINANCE_API_SECRET=optional_not_needed

# ==================== APPLICATION SETTINGS ====================
# Minimum confidence score (0-100) - higher = fewer but better signals
# FREE signals: 80-85% (more signals, decent quality)
# VIP signals: 88-92% (fewer signals, elite quality)
MIN_CONFIDENCE_SCORE=88

# Maximum signals per day
# RECOMMENDED: 3-5 VIP signals/day is ideal
# Too few (1-2) = subscribers feel cheated
# Too many (6+) = quality drops, becomes noise
MAX_SIGNALS_PER_DAY=5

# VIP-exclusive signals (higher confidence = VIP only)
VIP_MIN_CONFIDENCE=90
FREE_MAX_SIGNALS_PER_DAY=2

# Minimum daily volume in USD for pairs to scan
MIN_DAILY_VOLUME_USD=10000000

# Signal expiry time in minutes
SIGNAL_EXPIRY_MINUTES=30

# Minimum risk/reward ratio (1.0 = 1:1, 2.0 = 1:2)
MIN_RISK_REWARD=2.0

# Free channel delay after VIP (minutes)
# VIP members get signals FIRST
# Free channel gets same signal after delay (default 10 minutes)
FREE_CHANNEL_DELAY_MINUTES=10

# ==================== MARKETING ENGINE ====================
# This is your AUTOMATED TRAFFIC MACHINE
# Every approved signal gets pushed to ALL enabled channels automatically

# How many marketing posts per day in free channel
MARKETING_POSTS_PER_DAY=4
# What hours to post (24h format, UTC)
MARKETING_POST_HOUR_START=8
MARKETING_POST_HOUR_END=22

# --- VIRAL CONTENT GENERATION ---
# Auto-generates shareable images for every signal
# These images can be posted to social media, Discord, etc.
ENABLE_VIRAL_CONTENT=true

# --- COMMUNITY ENGAGEMENT ---
# Auto-posts polls, questions, CTAs to free channel every 30 minutes
# This keeps your channel active and drives member engagement
ENABLE_ENGAGEMENT_LOOP=true
ENABLE_WELCOME_MESSAGES=true

# --- INVITE CONTEST ---
# Tracks referrals and rewards top inviters
ENABLE_REFERRAL_CONTEST=true

# ==================== SOCIAL MEDIA INTEGRATION ====================
# TWITTER/X API - Every signal auto-posts as a tweet with chart image
# Get API keys from: https://developer.twitter.com/en/portal/dashboard
# All 4 keys required for posting
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# REDDIT API - Auto-posts signal summaries to crypto subreddits
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# DISCORD WEBHOOK - Cross-posts signals to Discord servers with rich embeds
# Get webhook URL from: Discord Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# GENERIC WEBHOOK - For IFTTT, Zapier, or any custom integration
# Every signal gets POSTed to this URL as JSON
MARKETING_WEBHOOK_URL=

# Daily report schedule (24h format, UTC)
# End-of-day report sent to admin + VIP channel
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=55

# Weekly report schedule
# Day: mon, tue, wed, thu, fri, sat, sun
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=20

# Database URL (leave blank to use Supabase)
DATABASE_URL=

# API Server settings
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard settings
# Port for the new Admin Dashboard (FastAPI-based control panel)
# Access it at http://localhost:8080 when the system is running
ADMIN_DASHBOARD_PORT=8080

# Old Streamlit dashboard port (legacy)
STREAMLIT_PORT=8501
